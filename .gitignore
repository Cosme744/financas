# Anotações locais. Nome de arquivo aparece inteiro no GitHub e fica no
# histórico para sempre, então nada daqui é versionado.
backend/*.txt

# Backups exportados pelo app: contêm todos os seus lançamentos.
backup-financas-*.json

# Lixo do sistema e dos editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Arquivos temporários de teste
_teste-*.html

# Credenciais do clasp (CLI do Apps Script). O .clasprc.json guarda o token
# de acesso à sua conta Google — nunca pode entrar num repositório público.
.clasp.json
.clasprc.json
